{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clients": "node start-clients.js",
    "build": "npm run build:proto && tsc -b && vite build",
    "build:proto": "pbjs -t static-module -w es6 -o src/proto/messages.js src/proto/messages.proto && pbts -o src/proto/messages.d.ts src/proto/messages.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "protobufjs": "^8.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "protobufjs-cli": "^2.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
